{
  "name": "hoalu",
  "version": "0.1.1",
  "description": "Hoalu SDK for Node.js, supporting Vietnamese securities brokers such as DNSE, SSI, TCBS, FHSC, and more.",
  "keywords": [
    "chungkhoan",
    "dnse",
    "fhsc",
    "hoalu",
    "securities",
    "ssi",
    "tcbs",
    "vietnam-stock"
  ],
  "license": "Apache-2.0",
  "author": "Hoalu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoalu/hoalu-node.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "allowScripts": {
    "esbuild@0.27.2": true
  }
}
